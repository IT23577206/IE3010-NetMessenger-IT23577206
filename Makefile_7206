CC = gcc

CFLAGS = -Wall -Wextra -Wpedantic -std=c11 -pthread

SERVER = server_7206
CLIENT = client_7206

all: $(SERVER) $(CLIENT)

$(SERVER): server_7206.c
	$(CC) $(CFLAGS) server_7206.c -o $(SERVER)

$(CLIENT): client_7206.c
	$(CC) $(CFLAGS) client_7206.c -o $(CLIENT)

clean:
	rm -f $(SERVER) $(CLIENT)
